# Dev/test-only fake "Internal Server", used to exercise Store & Forward
# end-to-end over HTTP and/or MQTT (see cmd/server-demo). Not part of the
# production gateway image.
FROM golang:1.25-alpine AS build

WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/server-demo ./cmd/server-demo

FROM alpine:3.20
COPY --from=build /out/server-demo /server-demo
EXPOSE 9000
ENTRYPOINT ["/server-demo"]
